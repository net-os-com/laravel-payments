{
    "name": "net-os/laravel-payments",
    "description": "PSP-agnostic payments, invoices and discount codes for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0",
        "spatie/laravel-data": "^4.0",
        "stripe/stripe-php": "^22.1",
        "lorisleiva/laravel-actions": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "NetOS\\Payments\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NetOS\\Payments\\PaymentsServiceProvider"
            ],
            "aliases": {
                "Payments": "NetOS\\Payments\\Facades\\Payments"
            }
        }
    },
    "minimum-stability": "stable"
}
